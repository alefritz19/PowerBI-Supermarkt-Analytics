// ================================================================================
// 03_DAX_Measures_Library / 03_customer_and_basket_kpis.dax
// Modul 3: Kundenbindung, Kohorten & Warenkorbanalyse (Customer & Basket Analytics)
// ================================================================================
// Beantwortet zentrale Fragen des Marketing- und CRM-Leiters:
// • Wie viele Kunden kaufen aktiv wieder? (Wiederkaufrate)
// • Welcher Umsatzanteil entfällt auf Kundenkartenbesitzer?
// • Welche Warengruppen landen gemeinsam im Korb? (Cross-Selling)
// ================================================================================

// 1. Gesamtzahl registrierter Kunden im Kundenstamm
Anzahl_Kunden_Gesamt = 
COUNTROWS(vw_dim_kunden)

// 2. Aktive Kunden (mindestens ein Einkauf im gewählten Filterzeitraum)
// DISTINCTCOUNTNOBLANK statt DISTINCTCOUNT: Bons ohne Kundenkarte haben KundeID = BLANK,
// DISTINCTCOUNT würde BLANK als zusätzlichen "Kunden" mitzählen (+1).
Aktive_Kunden =
DISTINCTCOUNTNOBLANK(vw_fct_verkaeufe[KundeID])

// 3. Durchdringungsquote Kundenkarte (% aller Einkäufe mit Kundenkarte)
Kundenkarten_Quote_Bons_Pct = 
VAR BonsMitKarte = 
    CALCULATE(
        [Anzahl_Bons],
        NOT(ISBLANK(vw_fct_verkaeufe[KundeID]))
    )
RETURN
DIVIDE(
    BonsMitKarte,
    [Anzahl_Bons],
    0
)

// 4. Umsatzanteil Kundenkarte (% des Bruttoumsatzes mit Kundenkarte)
Kundenkarten_Umsatz_Anteil_Pct = 
VAR UmsatzMitKarte = 
    CALCULATE(
        [Total_Umsatz_Brutto],
        NOT(ISBLANK(vw_fct_verkaeufe[KundeID]))
    )
RETURN
DIVIDE(
    UmsatzMitKarte,
    [Total_Umsatz_Brutto],
    0
)

// 5. Durchschnittlicher Umsatz pro aktivem Kunden (€ ARPU)
Umsatz_Pro_Kunde = 
DIVIDE(
    CALCULATE([Total_Umsatz_Brutto], NOT(ISBLANK(vw_fct_verkaeufe[KundeID]))),
    [Aktive_Kunden],
    0
)

// 6. Einkaufsfrequenz (Einkäufe pro aktivem Kunden)
Einkaufsfrequenz_Kunde = 
DIVIDE(
    CALCULATE([Anzahl_Bons], NOT(ISBLANK(vw_fct_verkaeufe[KundeID]))),
    [Aktive_Kunden],
    0
)

// 7. Mehrfachkäufer (Kunden mit mindestens 2 Einkäufen im Zeitraum)
Mehrfachkaeufer_Anzahl = 
VAR KundenMitEinkaeufen = 
    FILTER(
        VALUES(vw_dim_kunden[KundeID]),
        CALCULATE(DISTINCTCOUNT(vw_fct_verkaeufe[BonID])) >= 2
    )
RETURN
COUNTROWS(KundenMitEinkaeufen)

// 8. Wiederkaufrate (% der aktiven Kunden mit >= 2 Einkäufen)
Wiederkaufrate_Pct = 
DIVIDE(
    [Mehrfachkaeufer_Anzahl],
    [Aktive_Kunden],
    0
)

// 9. Neukunden im aktuellen Zeitraum (Ersteinkauf fand im Filterzeitraum statt)
// Wichtig: Der Ersteinkauf muss über den GESAMTEN Zeitraum ermittelt werden
// (REMOVEFILTERS auf dim_datum). Ohne das liefert MIN(BonDatum) nur den ersten Einkauf
// innerhalb des Filterzeitraums – dann wäre jeder aktive Kunde ein "Neukunde".
Neukunden_Anzahl =
VAR MinDate = MIN(dim_datum[Datum])
VAR MaxDate = MAX(dim_datum[Datum])
RETURN
COUNTROWS(
    FILTER(
        VALUES(vw_dim_kunden[KundeID]),
        VAR Ersteinkauf = CALCULATE(MIN(vw_fct_verkaeufe[BonDatum]), REMOVEFILTERS(dim_datum))
        RETURN Ersteinkauf >= MinDate && Ersteinkauf <= MaxDate
    )
)

// 10. Umsatz von Neukunden (€)
Neukunden_Umsatz =
VAR MinDate = MIN(dim_datum[Datum])
VAR MaxDate = MAX(dim_datum[Datum])
RETURN
CALCULATE(
    [Total_Umsatz_Brutto],
    FILTER(
        VALUES(vw_dim_kunden[KundeID]),
        VAR Ersteinkauf = CALCULATE(MIN(vw_fct_verkaeufe[BonDatum]), REMOVEFILTERS(dim_datum))
        RETURN Ersteinkauf >= MinDate && Ersteinkauf <= MaxDate
    )
)

// 11. Warenkorb-Cross-Selling: Anteil der Bons, die mindestens 2 verschiedene Kategorien enthalten
// Achtung: DISTINCTCOUNT(vw_dim_produkte[KategorieID]) würde hier immer alle Kategorien zählen,
// weil der Filter auf BonID bei einfacher Filterrichtung (Dimension -> Faktentabelle) nicht in die
// Produktdimension zurückfließt. SUMMARIZE über die Faktentabelle nutzt die Beziehung Faktentabelle -> Dimension.
Bons_Multi_Kategorie_Pct =
VAR MultiCatBons =
    COUNTROWS(
        FILTER(
            VALUES(vw_fct_verkaeufe[BonID]),
            CALCULATE(COUNTROWS(SUMMARIZE(vw_fct_verkaeufe, vw_dim_produkte[KategorieID]))) >= 2
        )
    )
RETURN
DIVIDE(
    MultiCatBons,
    [Anzahl_Bons],
    0
)
