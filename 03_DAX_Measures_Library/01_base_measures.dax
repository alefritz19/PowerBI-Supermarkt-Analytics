// ================================================================================
// 03_DAX_Measures_Library / 01_base_measures.dax
// Modul 1: Grundlegende Unternehmens-KPIs (FrischMarkt GmbH)
// ================================================================================
// Best Practice: Explizite Measures anstelle impliziter Standard-Aggregationen.
// Alle Kennzahlen referenzieren ausschließlich dwh.vw_fct_verkaeufe / dwh.vw_fct_abschreibungen.
// ================================================================================

// 1. Bruttoumsatz (€)
Total_Umsatz = 
SUM(vw_fct_verkaeufe[UmsatzBrutto])

Total_Umsatz_Brutto = 
SUM(vw_fct_verkaeufe[UmsatzBrutto])

// 2. Nettoumsatz (€ vor Steuern)
Total_Umsatz_Netto = 
SUM(vw_fct_verkaeufe[UmsatzNetto])

// 3. Umsatzsteuer (€)
Total_MwSt = 
SUM(vw_fct_verkaeufe[MwStBetrag])

// 4. Wareneinsatz Netto (€)
Total_Wareneinsatz = 
SUM(vw_fct_verkaeufe[WareneinsatzNetto])

// 5. Deckungsbeitrag / Rohertrag (€)
Total_Rohertrag = 
[Total_Umsatz_Netto] - [Total_Wareneinsatz]

// 6. Rohertragsmarge (% vom Bruttoumsatz / Nettoumsatz)
Rohertragsmarge_Pct = 
DIVIDE(
    [Total_Rohertrag],
    [Total_Umsatz],
    0
)

Rohertrag_Marge_Pct = 
DIVIDE(
    [Total_Rohertrag],
    [Total_Umsatz_Netto],
    0
)

// 7. Verkaufte Artikelmenge (Stück)
Total_Menge = 
SUM(vw_fct_verkaeufe[Menge])

// 8. Anzahl Kassenbons (Transaktionen)
Anzahl_Bons = 
DISTINCTCOUNT(vw_fct_verkaeufe[BonID])

// 9. Durchschnittlicher Bonwert brutto (€ pro Bon / Average Basket Value AOV)
Durchschnittsbon_AOV = 
DIVIDE(
    [Total_Umsatz],
    [Anzahl_Bons],
    0
)

Durchschnitt_Bonwert = 
DIVIDE(
    [Total_Umsatz_Brutto],
    [Anzahl_Bons],
    0
)

// 10. Artikel pro Kassenbon (Units per Transaction - UPT)
Artikel_Pro_Bon = 
DIVIDE(
    [Total_Menge],
    [Anzahl_Bons],
    0
)

// 11. Durchschnittlicher Verkaufspreis je Einheit (€)
Durchschnittspreis_Pro_Einheit = 
DIVIDE(
    [Total_Umsatz_Brutto],
    [Total_Menge],
    0
)

// 12. Summe gewährter Aktionsrabatte brutto (€)
Total_Rabatt_Brutto = 
SUM(vw_fct_verkaeufe[RabattBetrag])

// 13. Rabattquote (% am potenziellen Bruttoumsatz)
Rabattquote_Pct = 
DIVIDE(
    [Total_Rabatt_Brutto],
    [Total_Umsatz_Brutto] + [Total_Rabatt_Brutto],
    0
)

// 14. Gesamter Warenverlust durch Abschreibungen (€ netto)
Total_Abschreibungen = 
SUM(vw_fct_abschreibungen[VerlustNettoEUR])

Total_Abschreibungen_Netto = 
SUM(vw_fct_abschreibungen[VerlustNettoEUR])

// 15. Abschreibungsquote (% bezogen auf den Wareneinsatz)
Abschreibungsquote_Pct = 
DIVIDE(
    [Total_Abschreibungen_Netto],
    [Total_Wareneinsatz],
    0
)
